// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator graphql {
  provider           = "prisma-nestjs-graphql"
  output             = "../src/generated/graphql"
  reExport           = "All"
  noAtomicOperations = "true"

  fields_Validator_from  = "class-validator"
  fields_Validator_input = "true"

  decorate_1_type      = "*Nested*"
  decorate_1_field     = "!(connect|disconnect)"
  decorate_1_name      = "HideField"
  decorate_1_from      = "@nestjs/graphql"
  decorate_1_arguments = "[]"

  decorate_4_type      = "!(*Create*|*Update*)"
  decorate_4_field     = "password"
  decorate_4_name      = "HideField"
  decorate_4_from      = "@nestjs/graphql"
  decorate_4_arguments = "[]"

  decorate_5_type      = "+(*Create*|*Update*)"
  decorate_5_field     = "+(id|createdAt|updatedAt|expiredAt|uploadedAt)"
  decorate_5_name      = "HideField"
  decorate_5_from      = "@nestjs/graphql"
  decorate_5_arguments = "[]"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated"
  config   = "zod-generator-config.json"
}

generator dto {
  provider                        = "prisma-generator-nestjs-dto"
  output                          = "../src/generated/dto"
  prismaClientImportPath          = ""
  outputToNestJsResourceStructure = "false"
  flatResourceStructure           = "false"
  exportRelationModifierClasses   = "false"
  reExport                        = "true"
  generateFileTypes               = "all"
  createDtoPrefix                 = "Create"
  updateDtoPrefix                 = "Update"
  dtoSuffix                       = "Dto"
  entityPrefix                    = ""
  entitySuffix                    = "Entity"
  classValidation                 = "true"
  fileNamingStyle                 = "kebab"
  noDependencies                  = "false"
  outputType                      = "class"
  definiteAssignmentAssertion     = "false"
  requiredResponseApiProperty     = "true"
  prettier                        = "true"
  wrapRelationsAsType             = "false"
  showDefaultValues               = "true"
}

enum Status {
  Enabled
  Disabled
}

enum Target {
  Admin
  User
}

enum MediaStore {
  Local
  Qiniu
  Oss
  Cos
  S3
}

enum MediaType {
  Image
  Video
  Audio
  Document
  Archive
  Other
}

enum MediaVisibility {
  Public
  Private
  Shared
}

model Auth {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiredAt DateTime @default(now()) @map("expired_at")

  /// @DtoRelationIncludeId()
  adminId     String?  @map("admin_id")
  /// @DtoEntityHidden()
  admin       Admin?   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  userId      String?  @map("user_id")
  /// @DtoEntityHidden()
  user        User?    @relation(fields: [userId], references: [id])
  /// @DtoRelationIncludeId()
  companyId   String?  @map("company_id")
  /// @DtoEntityHidden()
  company     Company? @relation(fields: [companyId], references: [id])
  /// @HideField()
  token       String
  /// @HideField()
  fingerprint String?
  device      Json?
  location    Json?
  target      Target

  @@map("auths")
}

model Admin {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name     String @db.VarChar(100)
  /// @Validator.IsEmail()
  /// @zod.email().min(5).trim().toLowerCase()
  email    String @unique @db.VarChar(100)
  /// @DtoEntityHidden()
  password String

  /// @DtoRelationIncludeId()
  roleId String    @map("role_id")
  /// @DtoEntityHidden()
  role   AdminRole @relation(fields: [roleId], references: [id])

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  companies    AdminCompany[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  auths        Auth[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  logs         RequestLog[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFolders MediaFolder[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFiles   MediaFile[]

  @@map("admins")
}

model AdminRole {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name        String   @unique @db.VarChar(100)
  description String?
  /// @zod.min(2).trim()
  code        String   @unique @db.VarChar(100)
  permissions String[]

  /// @zod.optional()
  /// @DtoEntityHidden()
  admins Admin[]

  @@map("admin_roles")
}

model AdminCompany {
  /// @DtoReadOnly()
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @DtoRelationIncludeId()
  adminId   String  @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String  @map("company_id")
  /// @DtoEntityHidden()
  company   Company @relation(fields: [companyId], references: [id])

  permissions String[]

  @@id([adminId, companyId], name: "adminCompanyIdx")
  @@map("admin_companies")
}

model User {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name     String @db.VarChar(100)
  /// @zod.email().min(5).trim()
  /// @Validator.IsEmail()
  email    String @unique @db.VarChar(100)
  /// @DtoEntityHidden()
  password String

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  companies    CompanyUser[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  auths        Auth[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  logs         RequestLog[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFolders MediaFolder[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFiles   MediaFile[]

  @@map("users")
}

model Company {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name        String  @unique @db.VarChar(200)
  /// @zod.min(2).trim()
  alias       String? @db.VarChar(200)
  /// @zod.min(2).trim()
  code        String? @unique @db.VarChar(100)
  description String?

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  auths        Auth[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  admins       AdminCompany[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  roles        CompanyRole[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  users        CompanyUser[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  logs         RequestLog[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  mediaFolders MediaFolder[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  mediaFiles   MediaFile[]

  @@map("companies")
}

model CompanyRole {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name        String   @db.VarChar(100)
  description String?
  /// @zod.min(2).trim()
  code        String   @db.VarChar(100)
  permissions String[]

  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  users CompanyUser[]

  @@unique([companyId, code], name: "companyRoleIdx")
  @@map("company_roles")
}

model CompanyUser {
  /// @DtoReadOnly()
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @DtoRelationIncludeId()
  companyId String      @map("company_id")
  /// @DtoEntityHidden()
  company   Company     @relation(fields: [companyId], references: [id])
  /// @DtoRelationIncludeId()
  userId    String      @map("user_id")
  /// @DtoEntityHidden()
  user      User        @relation(fields: [userId], references: [id])
  /// @DtoRelationIncludeId()
  roleId    String      @map("role_id")
  /// @DtoEntityHidden()
  role      CompanyRole @relation(fields: [roleId], references: [id])

  @@id([companyId, userId], name: "companyUserIdx")
  @@map("company_users")
}

enum RequestMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
  GRAPHQL
}

model RequestLog {
  /// @DtoReadOnly()
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  recordAt  DateTime  @default(now()) @map("record_at")
  beforeAt  DateTime  @map("before_at")
  afterAt   DateTime? @map("after_at")
  duration  BigInt    @default(0)

  route   String?
  method  RequestMethod?
  message String?

  headers  Json?
  body     Json?
  params   Json?
  query    Json?
  device   Json?
  location Json?

  /// @zod.ipv4()
  ip          String?
  subject     String?
  action      String?
  language    String?
  fingerprint String?

  target Target?

  /// @DtoRelationIncludeId()
  userId    String?  @map("user_id")
  /// @DtoEntityHidden()
  user      User?    @relation(fields: [userId], references: [id])
  /// @DtoRelationIncludeId()
  adminId   String?  @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([subject, action], name: "requestResourceIdx")
  @@map("request_logs")
}

model MediaFolder {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.trim()
  name        String  @db.VarChar(100)
  description String?
  /// @zod.trim()
  path        String // 完整路径，如 "/folder1/subfolder"
  level       Int     @default(0) // 文件夹层级深度

  // 父子关系支持目录结构
  /// @DtoRelationIncludeId()
  parentId String?       @map("parent_id")
  /// @DtoEntityHidden()
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  /// @DtoEntityHidden()
  children MediaFolder[] @relation("FolderHierarchy")

  // 多层级资源隔离
  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  // 所有者信息
  ownerId   String? @map("owner_id")
  /// @DtoEntityHidden()
  ownerType Target  @map("owner_type") // Admin 或 User
  /// @DtoRelationIncludeId()
  adminId   String? @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?  @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  userId    String? @map("user_id")
  /// @DtoEntityHidden()
  user      User?   @relation(fields: [userId], references: [id])

  // 权限控制
  visibility MediaVisibility @default(Private)

  // 关联的媒体资源
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  files MediaFile[]

  @@unique([companyId, path], name: "folderPathIdx")
  @@index([companyId, parentId], name: "folderHierarchyIdx")
  @@index([ownerId, ownerType], name: "folderOwnerIdx")
  @@map("media_folders")
}

model MediaFile {
  /// @DtoReadOnly()
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  store  MediaStore @default(Local)
  status Status     @default(Enabled)

  // 文件基本信息
  mediaType  MediaType @map("media_type")
  mimeType   String    @map("mime_type")
  originName String    @map("origin_name")
  fileName   String    @map("file_name")
  fileSize   BigInt    @map("file_size") // 文件大小（字节）
  filePath   String    @default("/") @map("file_path") // 文件存储路径
  fileHash   String    @map("file_hash") // 文件哈希值用于去重

  // 文件元数据
  width       Int?
  height      Int?
  duration    Int? // 音视频时长（秒）
  metadata    Json? // 其他元数据信息
  description String?

  // 文件夹关联
  /// @DtoRelationIncludeId()
  folderId String?      @map("folder_id")
  /// @DtoEntityHidden()
  folder   MediaFolder? @relation(fields: [folderId], references: [id])

  // 多层级资源隔离
  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  // 所有者信息
  ownerId   String  @map("owner_id")
  /// @DtoEntityHidden()
  ownerType Target  @map("owner_type") // Admin 或 User
  /// @DtoRelationIncludeId()
  adminId   String? @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?  @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  userId    String? @map("user_id")
  /// @DtoEntityHidden()
  user      User?   @relation(fields: [userId], references: [id])

  // 权限控制
  visibility MediaVisibility @default(Private)

  @@unique([companyId, fileHash], name: "fileHashIdx")
  @@index([companyId, folderId], name: "fileFolderIdx")
  @@index([ownerId, ownerType], name: "fileOwnerIdx")
  @@index([mediaType, companyId], name: "fileTypeIdx")
  @@index([fileName, companyId], name: "fileNameIdx")
  @@map("media_files")
}
