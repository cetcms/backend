// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator graphql {
  provider           = "prisma-nestjs-graphql"
  output             = "../src/generated/graphql"
  reExport           = "All"
  noAtomicOperations = "true"
  omitModelsCount    = "true"
  purgeOutput        = "true"

  fields_Validator_from  = "class-validator"
  fields_Validator_input = "true"

  decorate_1_type      = "*Nested*Input*"
  decorate_1_field     = "!(connect|disconnect)"
  decorate_1_name      = "HideField"
  decorate_1_from      = "@nestjs/graphql"
  decorate_1_arguments = "[]"

  decorate_2_type      = "*WhereUniqueInput"
  decorate_2_field     = "+(AND|OR|NOT|createdAt|updatedAt)"
  decorate_2_name      = "HideField"
  decorate_2_from      = "@nestjs/graphql"
  decorate_2_arguments = "[]"

  decorate_4_type      = "!(*Create*|*Update*)"
  decorate_4_field     = "password"
  decorate_4_name      = "HideField"
  decorate_4_from      = "@nestjs/graphql"
  decorate_4_arguments = "[]"

  decorate_5_type      = "+(*Create*|*Update*)"
  decorate_5_field     = "+(id|createdAt|updatedAt|expiredAt|uploadedAt)"
  decorate_5_name      = "HideField"
  decorate_5_from      = "@nestjs/graphql"
  decorate_5_arguments = "[]"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated"
  config   = "zod-generator-config.json"
}

generator dto {
  provider                        = "prisma-generator-nestjs-dto"
  output                          = "../src/generated/dto"
  prismaClientImportPath          = ""
  outputToNestJsResourceStructure = "false"
  flatResourceStructure           = "false"
  exportRelationModifierClasses   = "false"
  reExport                        = "true"
  generateFileTypes               = "all"
  createDtoPrefix                 = "Create"
  updateDtoPrefix                 = "Update"
  dtoSuffix                       = "Dto"
  entityPrefix                    = ""
  entitySuffix                    = "Entity"
  classValidation                 = "true"
  fileNamingStyle                 = "kebab"
  noDependencies                  = "false"
  outputType                      = "class"
  definiteAssignmentAssertion     = "false"
  requiredResponseApiProperty     = "true"
  prettier                        = "true"
  wrapRelationsAsType             = "false"
  showDefaultValues               = "true"
}

enum Status {
  Enabled
  Disabled
}

enum Target {
  Admin
  Member
  Company
}

enum Owner {
  Admin
  Member
  Company
}

enum NotificationReceiver {
  Admin
  Member
  Company
}

enum NotificationSender {
  Admin
  Member
  Company
  System
}

enum NotificationPrivacy {
  Public
  Private
}

enum NotificationType {
  Alert
  Confirm
  Message
  Prompt
}

enum MediaStore {
  Local
  Qiniu
  Oss
  Cos
  S3
}

enum MediaType {
  Image
  Video
  Audio
  Document
  Archive
  Other
}

enum MediaVisibility {
  Public
  Private
  Shared
}

model Auth {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiredAt DateTime @default(now()) @map("expired_at")

  /// @DtoRelationIncludeId()
  adminId     String?  @map("admin_id")
  /// @DtoEntityHidden()
  admin       Admin?   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  memberId    String?  @map("member_id")
  /// @DtoEntityHidden()
  member      Member?  @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  companyId   String?  @map("company_id")
  /// @DtoEntityHidden()
  company     Company? @relation(fields: [companyId], references: [id])
  /// @HideField()
  token       String
  /// @HideField()
  fingerprint String?
  device      Json?
  location    Json?
  target      Target

  @@map("auths")
}

model Admin {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name     String @db.VarChar(100)
  /// @Validator.IsEmail()
  /// @zod.email().min(5).trim().toLowerCase()
  email    String @unique @db.VarChar(100)
  /// @DtoEntityHidden()
  password String

  avatar String?

  /// @DtoRelationIncludeId()
  roleId String    @map("role_id")
  /// @DtoEntityHidden()
  role   AdminRole @relation(fields: [roleId], references: [id])

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  companies              AdminCompany[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  auths                  Auth[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  logs                   RequestLog[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFolders           MediaFolder[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFiles             MediaFile[]
  notifications          Notification[]
  notificationRecipients NotificationRecipient[]

  @@map("admins")
}

model AdminRole {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name        String   @unique @db.VarChar(100)
  description String?
  /// @zod.min(2).trim()
  code        String   @unique @db.VarChar(100)
  permissions String[]

  /// @zod.optional()
  /// @DtoEntityHidden()
  admins Admin[]

  @@map("admin_roles")
}

model AdminCompany {
  /// @DtoReadOnly()
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// @DtoRelationIncludeId()
  adminId   String  @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String  @map("company_id")
  /// @DtoEntityHidden()
  company   Company @relation(fields: [companyId], references: [id])

  roleId String      @map("company_role_id")
  role   CompanyRole @relation(fields: [roleId], references: [id])

  @@id([adminId, companyId], name: "adminCompanyIdx")
  @@map("admin_companies")
}

model Member {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name     String  @db.VarChar(100)
  /// @zod.email().min(5).trim()
  /// @Validator.IsEmail()
  email    String  @unique @db.VarChar(100)
  /// @DtoEntityHidden()
  password String
  avatar   String?

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  companies              CompanyMember[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  auths                  Auth[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  logs                   RequestLog[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFolders           MediaFolder[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  mediaFiles             MediaFile[]
  notifications          Notification[]
  notificationRecipients NotificationRecipient[]

  @@map("members")
}

model Company {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name        String  @unique @db.VarChar(200)
  /// @zod.min(2).trim()
  alias       String? @db.VarChar(200)
  /// @zod.min(2).trim()
  code        String? @unique @db.VarChar(100)
  description String?
  logo        String?

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  auths                  Auth[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  admins                 AdminCompany[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  roles                  CompanyRole[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  members                CompanyMember[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  logs                   RequestLog[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  mediaFolders           MediaFolder[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField()
  mediaFiles             MediaFile[]
  notifications          Notification[]
  notificationRecipients NotificationRecipient[]

  @@map("companies")
}

model CompanyRole {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.min(2).trim()
  name        String   @db.VarChar(100)
  description String?
  /// @zod.min(2).trim()
  code        String   @db.VarChar(100)
  permissions String[]

  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  members CompanyMember[]
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*)' })
  admins  AdminCompany[]

  @@unique([companyId, code], name: "companyRoleIdx")
  @@map("company_roles")
}

model CompanyMember {
  /// @DtoReadOnly()
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @DtoRelationIncludeId()
  companyId String      @map("company_id")
  /// @DtoEntityHidden()
  company   Company     @relation(fields: [companyId], references: [id])
  /// @DtoRelationIncludeId()
  memberId  String      @map("member_id")
  /// @DtoEntityHidden()
  member    Member      @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  roleId    String      @map("role_id")
  /// @DtoEntityHidden()
  role      CompanyRole @relation(fields: [roleId], references: [id])

  @@id([companyId, memberId], name: "companyMemberIdx")
  @@map("company_members")
}

model Notification {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sentAt    DateTime @default(now()) @map("sent_at")

  // 通知基本信息
  title    Json?
  content  Json
  options  Json?
  status   Status  @default(Enabled)
  priority Int     @default(0) // 优先级，0: 普通, 1: 重要, 2: 紧急
  category String? @db.VarChar(50) // 通知分类

  // 发送者信息
  senderId  String?             @map("sender_id") @db.VarChar(50)
  sender    NotificationSender  @default(System) // Admin, Member, Company 或 System
  receiver  String[] // Admin, Member, Company
  privacy   NotificationPrivacy @default(Private)
  type      NotificationType    @default(Message)
  /// @DtoRelationIncludeId()
  adminId   String?             @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?              @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  memberId  String?             @map("member_id")
  /// @DtoEntityHidden()
  member    Member?             @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String?             @map("company_id")
  /// @DtoEntityHidden()
  company   Company?            @relation(fields: [companyId], references: [id])

  // 接收者信息 (支持多对多)
  recipients NotificationRecipient[]

  @@map("notifications")
}

model NotificationRecipient {
  /// @DtoReadOnly()
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  archivedAt DateTime? @map("archived_at")
  readAt     DateTime? @map("read_at") // 已读时间
  isRead     Boolean   @default(false) @map("is_read") // 是否已读
  isArchived Boolean   @default(false) @map("is_archived") // 是否归档
  isDeleted  Boolean   @default(false) @map("is_deleted") // 是否删除

  // 接收者信息
  receiverId String               @map("receiver_id") @db.VarChar(50)
  receiver   NotificationReceiver @map("receiver") // Admin, Member, Company
  /// @DtoRelationIncludeId()
  adminId    String?              @map("admin_id")
  /// @DtoEntityHidden()
  admin      Admin?               @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  memberId   String?              @map("member_id")
  /// @DtoEntityHidden()
  member     Member?              @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  companyId  String?              @map("company_id")
  /// @DtoEntityHidden()
  company    Company?             @relation(fields: [companyId], references: [id])

  // 关联的通知
  /// @DtoRelationIncludeId()
  notificationId String       @map("notification_id")
  /// @DtoEntityHidden()
  notification   Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, receiverId, receiver], name: "receiverIdx")
  @@map("notification_recipients")
}

enum RequestMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
  GRAPHQL
  GRAPHQL_WS
}

model RequestLog {
  /// @DtoReadOnly()
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  recordAt  DateTime  @default(now()) @map("record_at")
  beforeAt  DateTime  @map("before_at")
  afterAt   DateTime? @map("after_at")
  duration  BigInt    @default(0)

  route   String?
  method  RequestMethod?
  message String?

  headers  Json?
  body     Json?
  params   Json?
  query    Json?
  device   Json?
  location Json?

  /// @zod.ipv4()
  ip          String?
  subject     String?
  action      String?
  language    String?
  fingerprint String?

  target Target?

  /// @DtoRelationIncludeId()
  memberId  String?  @map("member_id")
  /// @DtoEntityHidden()
  member    Member?  @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  adminId   String?  @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([subject, action], name: "requestResourceIdx")
  @@map("request_logs")
}

model MediaFolder {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status @default(Enabled)

  /// @zod.trim()
  name        String  @db.VarChar(100)
  description String?
  /// @zod.trim()
  path        String // 完整路径，如 "/folder1/subfolder"
  depth       Int     @default(0) // 文件夹层级深度

  // 父子关系支持目录结构
  /// @DtoRelationIncludeId()
  parentId String?       @map("parent_id")
  /// @DtoEntityHidden()
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  /// @DtoEntityHidden()
  children MediaFolder[] @relation("FolderHierarchy")

  owner     Owner
  /// @DtoRelationIncludeId()
  adminId   String?  @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  memberId  String?  @map("member_id")
  /// @DtoEntityHidden()
  member    Member?  @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  // 关联的媒体资源
  /// @zod.optional()
  /// @DtoEntityHidden()
  /// @HideField({ match: '+(*Create*|*Update*|*UniqueInput*)' })
  files MediaFile[]

  @@unique([memberId, path], name: "memberFolderPathIdx")
  @@unique([adminId, path], name: "adminFolderPathIdx")
  @@unique([companyId, path], name: "companyFolderPathIdx")
  @@map("media_folders")
}

model MediaFile {
  /// @DtoReadOnly()
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  status Status     @default(Enabled)
  store  MediaStore @default(Local)

  // 文件基本信息
  mediaType MediaType @map("media_type")
  mimeType  String    @map("mime_type")
  fileName  String    @map("file_name")
  fileHash  String    @map("file_hash") // 文件哈希值
  fileSize  BigInt    @map("file_size") // 文件大小（字节）

  // 文件元数据
  width       Int?
  height      Int?
  duration    Int? // 音视频时长（秒）
  metadata    Json? // 其他元数据信息
  description String?
  extension   String  @map("extension")

  // 文件夹关联
  /// @DtoRelationIncludeId()
  folderId String      @map("folder_id")
  /// @DtoEntityHidden()
  folder   MediaFolder @relation(fields: [folderId], references: [id])

  owner     Owner
  // 多层级资源隔离
  /// @DtoRelationIncludeId()
  adminId   String?  @map("admin_id")
  /// @DtoEntityHidden()
  admin     Admin?   @relation(fields: [adminId], references: [id])
  /// @DtoRelationIncludeId()
  memberId  String?  @map("member_id")
  /// @DtoEntityHidden()
  member    Member?  @relation(fields: [memberId], references: [id])
  /// @DtoRelationIncludeId()
  companyId String?  @map("company_id")
  /// @DtoEntityHidden()
  company   Company? @relation(fields: [companyId], references: [id])

  // 权限控制
  visibility MediaVisibility @default(Public)

  @@unique([adminId, folderId, fileName], name: "adminFileIdx")
  @@unique([memberId, folderId, fileName], name: "memberFileIdx")
  @@unique([companyId, folderId, fileName], name: "companyFileIdx")
  @@map("media_files")
}
